VITE_APP_ID=cfr-admin
VITE_BASE_PATH=/
VITE_DEV_PORT=4011
VITE_ENABLE_DOMAIN_ROUTING=true
VITE_APP_SWITCHER_URL=http://localhost:4001/integrations/app-switcher/v1/app-switcher.js
VITE_APP_HUB_URL=http://localhost:4001/apps

# CFR.Acutis's real authentication API — no mock/preview auth exists in this project anymore.
# Points directly at CFR.Acutis running standalone (its "https" launch profile). If you run
# CFR.Acutis on plain http instead (its "http" profile), change this to http://localhost:5051/api/v1.
VITE_ACUTIS_API_BASE_URL=https://localhost:5051/api/v1
