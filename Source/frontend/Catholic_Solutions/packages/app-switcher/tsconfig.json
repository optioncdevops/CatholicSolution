{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "rootDir": "../.."
  },
  "include": [
    "vite.config.ts",
    "src/manifest.ts",
    "../../packages/app-registry/src/**/*.ts"
  ]
}
