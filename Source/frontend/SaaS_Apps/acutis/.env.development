# Public per-application build metadata only. No secrets belong in this file.
VITE_APP_ID=acutis
VITE_APP_TITLE=Acutis
VITE_DEV_PORT=4010

# Backend base URL — CFR.Gateway's /acutis prefix (see backend/Gateway/CFR.Gateway).
# Point directly at CFR.Acutis (http://localhost:5051) if running it standalone without the gateway.
VITE_APP_REST_API_BASE_URL=http://localhost:5051/api/v1

# Explicit mock/real switch (Task 9 rule: keep mock mode available, no UI rewrite to switch modes).
# "mock"  -> in-memory canned responses, no network calls
# "api"   -> real HTTP calls to VITE_APP_REST_API_BASE_URL (still only the DEV FAKE backend today)
VITE_ACUTIS_AUTH_MODE=mock
