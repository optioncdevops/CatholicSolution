# Public per-application build metadata only. No secrets belong in this file.
VITE_APP_ID=acutis
VITE_APP_TITLE=Acutis
VITE_DEV_PORT=4010

# Backend base URL — CFR.Gateway's /acutis prefix (see backend/Gateway/CFR.Gateway).
# Points directly at CFR.Acutis running standalone (its "https" launch profile — matches Visual
# Studio's default debug profile, see backend/Microservices/CFR.Acutis/Properties/launchSettings.json).
# If you run CFR.Acutis on plain http instead (its "http" profile), change this to http://localhost:5051/api/v1.
VITE_APP_REST_API_BASE_URL=https://localhost:5051/api/v1

# Explicit mock/real switch — keep mock mode available for offline frontend-only work, but default
# to real network calls now that CFR.Acutis requires (and is verified against) a real database —
# no DevelopmentFake/mock backend exists anymore (see docs/acutis-auth-spec/database-contract.md).
# "mock"  -> in-memory canned responses, no network calls (switch to this only for offline UI work)
# "api"   -> real HTTP calls to VITE_APP_REST_API_BASE_URL against the real backend
VITE_ACUTIS_AUTH_MODE=api
