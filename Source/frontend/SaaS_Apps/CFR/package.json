{
  "name": "@catholic-solutions/cfr",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run sync:app-switcher-manifest",
    "dev": "vite --mode development",
    "prebuild": "npm run sync:app-switcher-manifest",
    "build": "tsc -b && vite build --mode production",
    "prebuild:production": "npm run sync:app-switcher-manifest",
    "build:production": "tsc -b && vite build --mode production",
    "prebuild:staging": "npm run sync:app-switcher-manifest",
    "build:staging": "tsc -b && vite build --mode staging",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "preview": "vite preview",
    "sync:app-switcher-manifest": "node --experimental-strip-types scripts/generate-app-switcher-manifest.mjs",
    "test:app-switcher-manifest": "node --experimental-strip-types --test scripts/generate-app-switcher-manifest.test.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "~8.2.1"
  }
}
