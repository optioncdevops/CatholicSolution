{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "rootDir": ".",
    "paths": {
      "@shared/*": [
        "./src/shared/*"
      ],
      "@registry/*": [
        "./src/registry/*"
      ]
    }
  },
  "include": [
    "vite.config.ts"
  ]
}
