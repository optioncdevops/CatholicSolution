      "admin-route": {
        "ClusterId": "admin-cluster",
        "Match": {
          "Path": "/admin/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/admin"
          }
        ]
      },
      "member-route": {
        "ClusterId": "member-cluster",
        "Match": {
          "Path": "/member/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/member"
          }
        ]
      }

    },
    "Clusters": {
      "acutis-cluster": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        },
        "Destinations": {
