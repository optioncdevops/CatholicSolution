{
  "Gateway": {
    "SwaggerRoutePrefix": "swagger",

    "AcutisEnabled": "true",
    "SsoEnabled": "true",
    "SmsEnabled": "true",
    "ReportEnabled": "true",
    "FamilyEnabled": "true",
    "AdmissionEnabled": "true",
    "ComponentEnabled": "true",
    "ReferenceEnabled": "true",
    "EformEnabled": "true",
    "DioceseEnabled": "true",
    "FeeEnabled": "true",
    "AdminEnabled": "true",
    "MemberEnabled": "true",

    "AcutisPathPrefix": "/acutis",
    "SsoPathPrefix": "/sso",
    "SmsPathPrefix": "/sms",
    "ReportPathPrefix": "/reports",
    "AdmissionPathPrefix": "/admission",
    "FamilyPathPrefix": "/family",
    "ComponentPathPrefix": "/component",
    "ReferencePathPrefix": "/reference",
    "EformPathPrefix": "/eforms",
    "DiocesePathPrefix": "/diocese",
    "FeePathPrefix": "/fees",
    "AdminPathPrefix": "/admin",
    "MemberPathPrefix": "/member",

    "AcutisUpstreamOrigin": "https://localhost:5047",
    "SsoUpstreamOrigin": "https://localhost:5002",
    "SmsUpstreamOrigin": "https://localhost:5003",
    "ReportUpstreamOrigin": "https://localhost:5010",
    "FamilyUpstreamOrigin": "https://localhost:5006",
    "AdmissionUpstreamOrigin": "https://localhost:5007",
    "ComponentUpstreamOrigin": "https://localhost:5008",
    "ReferenceUpstreamOrigin": "https://localhost:5011",
    "EformUpstreamOrigin": "https://localhost:5005",
    "DioceseUpstreamOrigin": "https://localhost:5012",
    "FeeUpstreamOrigin": "https://localhost:5043",
    "AdminUpstreamOrigin": "https://localhost:5042",
    "MemberUpstreamOrigin": "https://localhost:5044"
  },
  "ReverseProxy": {
    "Routes": {
      "acutis-route": {
        "ClusterId": "acutis-cluster",
        "Match": {
          "Path": "/acutis/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/acutis"
          }
        ]
      },
      "sso-route": {
        "ClusterId": "sso-cluster",
        "Match": {
          "Path": "/sso/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/sso"
          }
        ]
      },
      "sms-route": {
        "ClusterId": "sms-cluster",
        "Match": {
          "Path": "/sms/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/sms"
          }
        ]
      },
      "report-route": {
        "ClusterId": "report-cluster",
        "Match": {
          "Path": "/reports/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/reports"
          }
        ]
      },
      "admission-route": {
        "ClusterId": "admission-cluster",
        "Match": {
          "Path": "/admission/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/admission"
          }
        ]
      },
      "family-route": {
        "ClusterId": "family-cluster",
        "Match": {
          "Path": "/family/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/family"
          }
        ]
      },
      "component-route": {
        "ClusterId": "component-cluster",
        "Match": {
          "Path": "/component/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/component"
          }
        ]
      },
      "reference-route": {
        "ClusterId": "reference-cluster",
        "Match": {
          "Path": "/reference/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/reference"
          }
        ]
      },
      "eforms-route": {
        "ClusterId": "eforms-cluster",
        "Match": {
          "Path": "/eforms/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/eforms"
          }
        ]
      },
      "diocese-route": {
