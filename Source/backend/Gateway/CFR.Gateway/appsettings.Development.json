        },
        "Destinations": {
          "referenceServices": {
            "Address": "https://localhost:5011"
          }
        }
      },
      "eforms-cluster": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        },
        "Destinations": {
          "eformServices": {
            "Address": "https://localhost:5005"
          }
        }
      },
      "diocese-cluster": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        },
        "Destinations": {
          "dioceseServices": {
            "Address": "https://localhost:5012"
