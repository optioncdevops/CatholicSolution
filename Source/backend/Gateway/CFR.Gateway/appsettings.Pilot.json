{
  "Gateway": {
    "SwaggerRoutePrefix": "swagger",

    "AcutisEnabled": "true",
    "PortalEnabled": "true",

    "AcutisPathPrefix": "/acutis",
    "PortalPathPrefix": "/portal",

    "AcutisUpstreamOrigin": "http://localhost:5051",
    "PortalUpstreamOrigin": "http://localhost:5052"
  },
  "ReverseProxy": {
    "Routes": {
      "portal-api-cfrlaunch": {
        "ClusterId": "portal-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/v1/CFRLaunch/{**catch-all}"
        }
      },
      "portal-api-portallogin": {
        "ClusterId": "portal-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/v1/PortalLogin/{**catch-all}"
        }
      },
      "acutis-api-unprefixed": {
        "ClusterId": "acutis-cluster",
        "Order": 10,
        "Match": {
          "Path": "/api/v1/{**catch-all}"
        }
      },
      "acutis-route": {
        "ClusterId": "acutis-cluster",
        "Match": {
          "Path": "/acutis/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/acutis"
          }
        ]
      },
      "portal-route": {
        "ClusterId": "portal-cluster",
        "Match": {
          "Path": "/portal/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/portal"
          }
        ]
      }
    },
    "Clusters": {
      "acutis-cluster": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        },
        "Destinations": {
          "acutisServices": {
            "Address": "http://localhost:5051"
          }
        }
      },
      "portal-cluster": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        },
        "Destinations": {
          "portalServices": {
            "Address": "http://localhost:5052"
          }
        }
      }
    }
  }
}
