<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Central Package Management requires each feed to say which packages it may
    serve (NU1507); without this, restore has to probe every configured feed for
    every package, which is both slow and non-deterministic.

    Sources are referenced by name only - they are inherited from the machine's
    NuGet configuration, so no feed URLs or credentials are stored in the repo.
    This solution consumes nothing from DevExpress today; the mapping is kept so
    that a DevExpress.* package would still resolve if one is ever added.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="DevExpress">
      <package pattern="DevExpress.*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
