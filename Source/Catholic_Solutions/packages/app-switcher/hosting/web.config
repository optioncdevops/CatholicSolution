<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="app-switcher/v1/app-switcher.js">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="public, max-age=86400, stale-while-revalidate=604800" />
          <add name="Access-Control-Allow-Origin" value="*" />
          <add name="X-Content-Type-Options" value="nosniff" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  <location path="app-switcher/v1/catalog.js">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="public, max-age=300, must-revalidate" />
          <add name="Access-Control-Allow-Origin" value="*" />
          <add name="X-Content-Type-Options" value="nosniff" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
