{
  "name": "catholic-solutions-workspace",
  "private": true,
  "version": "1.3.9",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:hub": "npm run dev --workspace @catholic-solutions/app-hub",
    "dev:school": "npm run dev --workspace @catholic-solutions/optionc-school",
    "dev:money": "npm run dev --workspace @catholic-solutions/matt-money",
    "dev:alerts": "npm run dev --workspace @catholic-solutions/arc-alerts",
    "dev:parish": "npm run dev --workspace @catholic-solutions/optionc-parish",
    "dev:content": "npm run dev --workspace @catholic-solutions/catholic-content",
    "dev:directory": "npm run dev --workspace @catholic-solutions/unified-directory",
    "dev:support": "npm run dev --workspace @catholic-solutions/support-center",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint \"apps/**/src/**/*.{ts,tsx}\" \"packages/shared/src/**/*.{ts,tsx}\"",
    "export:solution": "node scripts/export-solution.mjs",
    "export:all": "node scripts/export-solution.mjs all",
    "build:hub": "npm run build --workspace @catholic-solutions/app-hub",
    "build:school": "npm run build --workspace @catholic-solutions/optionc-school",
    "build:money": "npm run build --workspace @catholic-solutions/matt-money",
    "build:alerts": "npm run build --workspace @catholic-solutions/arc-alerts",
    "build:parish": "npm run build --workspace @catholic-solutions/optionc-parish",
    "build:content": "npm run build --workspace @catholic-solutions/catholic-content",
    "build:directory": "npm run build --workspace @catholic-solutions/unified-directory",
    "build:support": "npm run build --workspace @catholic-solutions/support-center",
    "build:staging": "npm run build:staging --workspaces --if-present",
    "build:production": "npm run build:production --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.10.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "~8.2.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10"
  }
}
