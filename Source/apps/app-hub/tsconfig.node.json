{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "rootDir": "../..",
    "paths": {
      "@shared/*": [
        "../../packages/shared/src/*"
      ]
    }
  },
  "include": [
    "vite.config.ts",
    "../../packages/shared/src/platform/integrations/app-switcher/manifest.ts",
    "../../packages/shared/src/app/config/appCatalog.ts",
    "../../packages/shared/src/auth/appAuthConfig.ts",
    "../../packages/shared/src/app/types/app.ts"
  ]
}
